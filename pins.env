# pf-hwprobe — pinned refs for the reproducible build.
#
# Every external source pulled by build.sh + docker/Dockerfile resolves through this file
# (matches the sim's docker/*.pin pattern; committed so a rebuild months later is byte-
# for-byte the same as today). Update pins on their own PR with a short rationale.

# E2 runtime (libpocketforge C ABI). ABI frozen v1 (runtime/STABILITY.md).
RUNTIME_REPO=https://github.com/pocketforge-os/runtime.git
RUNTIME_COMMIT=0fedcdbadbcc0415687ed4861b163e3f36320ef3
RUNTIME_REF=origin/main

# E5 simulator + its bundled SDL3 render build (feeds the sim harness).
# Bumped (bead tsp-ihne1.56.5, incident PR5) to sim main = PR#62 merge (tsp-ihne1.56.1):
# the FIRST sim whose control surface feeds input through per-run PRIVATE FIFOs created
# inside the container (control/control_surface.py, FifoSynth) instead of opening the
# host-global /dev/uinput node. The prior pin b2fc5b8e (sim#33) still imported
# uinput_synth.Synth, so with hwprobe-smoke.yml's --device/-v /dev/input flags deleted
# that sim would fail closed — the pin bump and the flag deletion are ONE atomic change.
# hwprobe-smoke.yml clones the sim at this commit and docker-builds pocketforge-sim,
# so the sim's control_surface + check-control matrix + qemu-tsp + rootfs + the baked
# platform descriptors all come from ONE coherent cascade ref-pair with PLATFORM below.
# (prev b2fc5b8e = sim#33 pin cascade, 2026-07-26; before that 3b763a5 = sim#24/A1.)
SIM_REPO=https://github.com/pocketforge-os/sim.git
SIM_COMMIT=ee3efee9367ebdbec9639bc86118696b93383917
SIM_REF=origin/main

# E1 platform descriptors (read-only consumer; verifies the a133/a523 delta).
# Bumped (bead tsp-ihne1.56.5) to EXACTLY the platform sha the new sim pin carries in
# its docker/platform.pin: platform PR#309 merge a86adf6f. This keeps the pf-hwprobe
# local-run --platform in step with the platform the sim image bakes for CI, so local +
# CI descriptors agree. a86adf6f is the coherent pair with SIM_COMMIT above; from the
# prior pin c98ffcb9 the a133/a523 descriptors DO change (sticks unsigned 12-bit
# 0..4095 flat/fuzz 0, west/north BTN_NORTH 307, VOL-/VOL+ system rows, v2
# [model]/[physical] rows) — the same descriptors the sim PR#62 headless-suite ran
# green on (capabilities.toml a133 2b77f51f…, a523 44a095d7…).
# (prev c98ffcb9 = platform PR#76, 2026-07-26; before that 4ae14c56 = PR#67/A1.)
PLATFORM_REPO=https://github.com/pocketforge-os/platform.git
PLATFORM_COMMIT=a86adf6fa4c5d8f4a97db50d0fa23035adfe816a
PLATFORM_REF=origin/main

# Toolchain image (Rust + gcc-aarch64 cross); newer Rust needed for indexmap
# 2.14+ which pulls edition2024 (rust >= 1.85). runtime/Cargo.toml only asserts
# MSRV 1.77 for its own code — the crates.io dep graph is the actual gate.
RUST_IMAGE=rust:1.85-bookworm
